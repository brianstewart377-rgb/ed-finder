{
  "name": "@ed-finder/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "node scripts/static-preview.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && node --test scripts/static-preview.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "cypress run --browser chrome",
    "generate:api": "svelte-kit sync && node scripts/capture-openapi.mjs && openapi-ts"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.4.2",
    "cypress": "15.21.1",
    "eslint": "10.9.1",
    "eslint-plugin-svelte": "3.23.0",
    "jsdom": "27.4.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.0"
  },
  "dependencies": {
    "@lucide/svelte": "1.37.0",
    "@tanstack/svelte-query": "6.1.48",
    "bits-ui": "2.19.0",
    "json-with-bigint": "3.5.10"
  }
}

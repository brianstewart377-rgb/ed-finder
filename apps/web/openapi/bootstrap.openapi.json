{
  "openapi": "3.1.0",
  "info": { "title": "ED-Finder bootstrap API", "version": "1.0.0" },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Healthy",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/api/auth/session": {
      "get": {
        "operationId": "getAuthSession",
        "responses": {
          "200": {
            "description": "Session",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthSessionResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status", "database", "version", "build_sha"],
        "properties": {
          "status": { "type": "string" },
          "database": { "type": "string" },
          "version": { "type": "string" },
          "build_sha": { "type": "string" }
        }
      },
      "AuthUserResponse": {
        "type": "object",
        "required": ["commander_name", "is_owner"],
        "properties": {
          "commander_name": {
            "anyOf": [{ "type": "string" }, { "type": "null" }]
          },
          "is_owner": { "type": "boolean" }
        }
      },
      "AuthSessionResponse": {
        "type": "object",
        "required": ["authenticated"],
        "properties": {
          "authenticated": { "type": "boolean" },
          "user": {
            "anyOf": [
              { "$ref": "#/components/schemas/AuthUserResponse" },
              { "type": "null" }
            ]
          },
          "owner_claim_available": { "type": "boolean", "default": false }
        }
      }
    }
  }
}

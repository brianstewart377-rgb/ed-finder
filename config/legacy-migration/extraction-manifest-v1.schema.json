{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed-finder.invalid/schemas/extraction-manifest-v1.schema.json",
  "title": "ED-Finder reviewed selective extraction manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "dump_sha256", "tables", "owner_approval", "abort_conditions", "rollback_conditions"],
  "properties": {
    "schema_version": {"const": "legacy-selective-extraction-manifest/v1"},
    "manifest_id": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"},
    "dump_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tables": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/table"}},
    "owner_approval": {"$ref": "#/$defs/approval"},
    "abort_conditions": {"$ref": "#/$defs/conditions"},
    "rollback_conditions": {"$ref": "#/$defs/conditions"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"},
    "qualifiedIdentifier": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*(\\.[a-z_][a-z0-9_]*)?$"},
    "conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "count": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["exact"], "properties": {"exact": {"type": "integer", "minimum": 0}}}, {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum"], "properties": {"minimum": {"type": "integer", "minimum": 0}, "maximum": {"type": "integer", "minimum": 0}}}]},
    "filter": {"type": "object", "additionalProperties": false, "required": ["column", "operator", "value"], "properties": {"column": {"$ref": "#/$defs/identifier"}, "operator": {"enum": ["eq", "in", "range"]}, "value": {}}},
    "relationship": {"type": "object", "additionalProperties": false, "required": ["source_columns", "referenced_table", "referenced_columns", "required"], "properties": {"source_columns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}}, "referenced_table": {"$ref": "#/$defs/qualifiedIdentifier"}, "referenced_columns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}}, "required": {"const": true}}},
    "mapping": {"type": "object", "additionalProperties": false, "required": ["table", "columns"], "properties": {"table": {"$ref": "#/$defs/qualifiedIdentifier"}, "columns": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/identifier"}}}},
    "table": {"type": "object", "additionalProperties": false, "required": ["source_table", "columns", "key_filters", "maximum_rows", "destination_mapping", "idempotency_key_columns", "conflict_policy", "relationship_validations", "expected_source_count", "expected_target_count"], "properties": {"source_table": {"$ref": "#/$defs/qualifiedIdentifier"}, "columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}, "key_filters": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/filter"}}, "maximum_rows": {"type": "integer", "minimum": 1}, "destination_mapping": {"$ref": "#/$defs/mapping"}, "idempotency_key_columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}, "conflict_policy": {"enum": ["abort", "skip_existing", "update_if_unchanged"]}, "relationship_validations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/relationship"}}, "expected_source_count": {"$ref": "#/$defs/count"}, "expected_target_count": {"$ref": "#/$defs/count"}}},
    "approval": {"type": "object", "additionalProperties": false, "required": ["owner", "decision", "approved_at", "scope"], "properties": {"owner": {"type": "string", "minLength": 1}, "decision": {"const": "approved"}, "approved_at": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}}}
  }
}

# Copy to /opt/octopus/.env, replace every __REQUIRED_*__ marker, then chmod 0600.
# Values are intentionally invalid. Generate fresh values; do not reuse another installation.
OCTOPUS_POSTGRES_PASSWORD=__REQUIRED_STRONG_RANDOM_DATABASE_PASSWORD__
OCTOPUS_DATABASE_URL=__REQUIRED_URL_WITH_PERCENT_ENCODED_DATABASE_PASSWORD__
BETTER_AUTH_SECRET=__REQUIRED_FRESH_RANDOM_AUTH_SECRET__
OCTOPUS_DATA_KEY=__REQUIRED_FRESH_64_HEX_DATA_KEY__

GITHUB_APP_ID=__REQUIRED_GITHUB_APP_ID__
GITHUB_APP_PRIVATE_KEY=__REQUIRED_GITHUB_APP_PRIVATE_KEY_WITH_ESCAPED_NEWLINES__
GITHUB_WEBHOOK_SECRET=__REQUIRED_FRESH_GITHUB_WEBHOOK_SECRET__
GITHUB_APP_CLIENT_ID=__REQUIRED_GITHUB_APP_CLIENT_ID__
GITHUB_APP_CLIENT_SECRET=__REQUIRED_GITHUB_APP_CLIENT_SECRET__
NEXT_PUBLIC_GITHUB_APP_SLUG=__REQUIRED_GITHUB_APP_SLUG__
GITHUB_STATE_SECRET=__REQUIRED_FRESH_GITHUB_STATE_SECRET__

OCTOPUS_ADMIN_EMAIL=__REQUIRED_INITIAL_ADMIN_EMAIL__
OCTOPUS_ADMIN_PASSWORD=__REQUIRED_STRONG_INITIAL_ADMIN_PASSWORD__
ADMIN_EMAILS=__REQUIRED_INITIAL_ADMIN_EMAIL__

BETTER_AUTH_URL=http://127.0.0.1:43300
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43300
ENABLE_REVIEW_WORKERS=false
OCTOPUS_EMBED_PROVIDER=openai
OCTOPUS_EMBED_MODEL=text-embedding-3-large

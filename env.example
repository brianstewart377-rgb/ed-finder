# ── ED Finder environment variables ─────────────────────────────────────────
# Copy this file to `.env` and fill in the real values before running
# `sudo bash setup.sh` or `docker compose up -d`.

# Postgres password (used by postgres, pgbouncer, api, eddn, importer).
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Optional read-only Postgres DSN for admin/operator read surfaces and admin
# check operations. Leave blank to reuse DATABASE_URL with read-only
# transactions until a dedicated role is provisioned.
DATABASE_READONLY_URL=

# Optional service-specific Postgres DSNs for role-separated production
# deployments. Leave blank to keep using the shared `edfinder` DSN.
#
# Typical end state:
# - DATABASE_APP_URL:        app writer for api + eddn
# - DATABASE_IMPORT_URL:     importer/backfill writer
# - DATABASE_MAINTENANCE_URL: maintenance writer for prune/analyze jobs
# - DATABASE_MIGRATION_URL:  schema-change role used only by migration scripts
DATABASE_APP_URL=
DATABASE_IMPORT_URL=
DATABASE_MAINTENANCE_URL=
DATABASE_MIGRATION_URL=

# Optional rclone remote path for offsite Postgres backup copies, for example:
#   s3:ed-finder-prod/postgres
#   storagebox:ed-finder/backups/postgres
# Leave blank to keep backups on the local host only.
BACKUP_OFFSITE_REMOTE=
# RCLONE_CONFIG_STORAGEBOX_* names must match the remote name used in
# BACKUP_OFFSITE_REMOTE; change one, change all.
RCLONE_CONFIG_STORAGEBOX_TYPE=
RCLONE_CONFIG_STORAGEBOX_HOST=
RCLONE_CONFIG_STORAGEBOX_USER=
RCLONE_CONFIG_STORAGEBOX_PORT=
RCLONE_CONFIG_STORAGEBOX_PASS=

# Optional dead-man's-switch heartbeat URLs. The external service alerts when
# an expected ping does not arrive; leave blank to disable each ping entirely.
BACKUP_HEARTBEAT_URL=
BACKUP_OFFSITE_HEARTBEAT_URL=

# Nightly-update dead-man's switch: clean runs ping the plain URL; degraded
# runs that complete with warnings ping URL/fail. Fatal aborts send no ping.
NIGHTLY_UPDATE_HEARTBEAT_URL=

# Map materialized-view refresh dead-man's switch; pinged only after success.
MAP_REFRESH_HEARTBEAT_URL=

# EDDN ingest freshness dead-man's switch: the external service alerts when
# the ping does not arrive. Leave the URL blank to disable the watchdog.
EDDN_WATCHDOG_HEARTBEAT_URL=
EDDN_WATCHDOG_MAX_AGE_MINUTES=30

# The disk watchdog uses an inverted dead-man's switch: it pings only while
# healthy. Default 40GB because free space dips to roughly 61GB nightly while
# the new backup is written before the old one is pruned; a higher threshold
# would alert nightly on a healthy system.
DISK_WATCHDOG_HEARTBEAT_URL=
DISK_WATCHDOG_MIN_FREE_GB=40
DISK_WATCHDOG_PATH=/data

# Admin-token — required for /api/admin/* and /api/cache/clear.
# Leave blank to disable those endpoints entirely (default / safest).
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Optional read-only station enrichment status artifact for the Admin tab.
# Generate it from an operator job with:
#   python3 scripts/station_enrichment_status.py --json > /data/logs/station-enrichment-status.json
# Leave blank to show enrichment status as unavailable.
ENRICHMENT_STATUS_JSON_PATH=

# Optional read-only warehouse reconciliation/status artifact for the Admin tab.
# Publish a sanitized/reviewed warehouse reconciliation JSON report to a path
# mounted into the API container, for example /data/logs/warehouse-status.json.
# Leave blank to show warehouse status as unavailable.
ENRICHMENT_WAREHOUSE_STATUS_JSON_PATH=

# Comma-separated list of allowed CORS origins.
# Change this for staging/dev deployments.
CORS_ORIGINS=https://ed-finder.app,https://www.ed-finder.app

# Set to "true" only when debugging locally. Leaks asyncpg error text
# (SQL, table/column names) in HTTP responses when true.
EXPOSE_ERROR_DETAIL=false

# Logging level for all Python services.
LOG_LEVEL=INFO

# Maintenance retention posture.
# Superseded/expired evidence rows keep the latest historical row per subject and
# prune older history after this many days during weekly maintenance.
EVIDENCE_RECORD_RETENTION_DAYS=90
# Local backup archives are pruned after this many days. Offsite retention is
# applied by the backup script only after a successful offsite upload.
BACKUP_RETENTION_DAYS=14
BACKUP_RETENTION_MIN_ARCHIVES=3
# Offsite age is selected from the timestamp embedded in each archive filename;
# the archive floor is never crossed even when every remaining archive is old.
BACKUP_OFFSITE_RETENTION_DAYS=30
BACKUP_OFFSITE_RETENTION_MIN_ARCHIVES=3
# Completed/failed admin job rows older than this are pruned during weekly
# maintenance to keep the ops ledger bounded.
ADMIN_JOB_RUN_RETENTION_DAYS=60

# Targeted EDSM enrichment pacing. Keep these conservative for bulk station/body
# backfills; Retry-After from EDSM is honored before these 429 defaults.
EDSM_HTTP_REQUEST_DELAY_SECONDS=0.5
EDSM_HTTP_429_BACKOFF_SECONDS=60
EDSM_HTTP_429_BACKOFF_MULTIPLIER=2

# Monitoring is opt-in. Put the Grafana password in a local file; Grafana's
# guarded entrypoint refuses empty, default, or placeholder credentials.
GRAFANA_USER=admin
GRAFANA_PASSWORD_FILE=./config/grafana_admin_password.local

# Optional native Healthchecks.io Prometheus integration. The targets file is
# a copy of config/healthchecks_targets.example.yml with the project UUID set;
# the token file contains only a read-only Healthchecks API key. Leave both
# blank to use the committed disabled/empty defaults and make no external call.
HEALTHCHECKS_PROMETHEUS_TARGETS_FILE=
HEALTHCHECKS_PROMETHEUS_TOKEN_FILE=

# Error tracking (GlitchTip, self-hosted Sentry-API-compatible) — fully
# opt-in end to end. See docs/operations/glitchtip-error-tracking.md.
#
# Enable the stack itself with: docker compose --profile errortracking up -d
GLITCHTIP_POSTGRES_PASSWORD=
GLITCHTIP_SECRET_KEY=
GLITCHTIP_DOMAIN=http://localhost:8080
GLITCHTIP_DEFAULT_FROM_EMAIL=glitchtip@ed-finder.app

# After creating an org + project in the GlitchTip UI (see the runbook), set
# the DSNs it gives you here. Leave blank to disable API/frontend error
# capture entirely even if the glitchtip_* containers are running.
SENTRY_DSN=
VITE_SENTRY_DSN=

# Opt-in background task (apps/api/src/ingest/eddn_client.py): feeds
# journal_events/body_scan_facts from the live EDDN relay for the
# simulation/buildability engine. Independent of, not a replacement for,
# the client-side journal-import lane. Defaults off.
EDDN_SIMULATION_INGEST_ENABLED=false

# Grafana's Sentry-compatible datasource, so error-rate trends sit next to
# the infra metrics dashboard. Requires a GlitchTip internal integration
# auth token (Read access to Project/Issue&Event/Organization) written to
# GLITCHTIP_GRAFANA_AUTH_TOKEN_FILE. Leave both blank/default to leave the
# datasource provisioned but unauthenticated.
GLITCHTIP_GRAFANA_ORG_SLUG=not-configured
GLITCHTIP_GRAFANA_AUTH_TOKEN_FILE=./config/glitchtip_grafana_auth_token.disabled

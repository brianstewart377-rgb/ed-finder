# ── ED Finder repository/local environment variable reference ────────────────
# This file is for local/disposable development and repository tooling. It is
# NOT the V3 production secret/configuration authority. `setup.sh` is retired.
# For production, use docs/operations/infrastructure-status.md and an explicitly
# current V3 runbook/secret-management path. Do not infer host, storage, backup,
# or credential settings from this example.

# Postgres password used by the repository's local/legacy Compose services.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Optional read-only Postgres DSN for admin/operator read surfaces and admin
# check operations. Leave blank to reuse DATABASE_URL with read-only
# transactions until a dedicated role is provisioned.
DATABASE_READONLY_URL=

# Optional service-specific Postgres DSNs for role-separated deployments.
# Leave blank to keep using the shared `edfinder` DSN in environments that
# intentionally use this repository-level configuration model.
#
# Typical role split:
# - DATABASE_APP_URL:         app writer for api + eddn
# - DATABASE_IMPORT_URL:      importer/backfill writer
# - DATABASE_MAINTENANCE_URL: maintenance writer for prune/analyze jobs
# - DATABASE_MIGRATION_URL:   schema-change role used only by migration scripts
DATABASE_APP_URL=
DATABASE_IMPORT_URL=
DATABASE_MAINTENANCE_URL=
DATABASE_MIGRATION_URL=

# Legacy/local backup-helper remote. Leave blank unless a specifically reviewed
# non-production/recovery workflow defines the target. The former Hetzner
# Storage Box target and its provider-specific rclone credential variables are
# intentionally not published as current configuration here. V3 backup/PITR
# storage is not to be inferred from V2 history.
BACKUP_OFFSITE_REMOTE=

# Optional dead-man's-switch heartbeat URLs. The external service alerts when
# an expected ping does not arrive; leave blank to disable each ping entirely.
BACKUP_HEARTBEAT_URL=
BACKUP_OFFSITE_HEARTBEAT_URL=

# Nightly-update dead-man's switch: clean runs ping the plain URL; degraded
# runs that complete with warnings ping URL/fail. Fatal aborts send no ping.
NIGHTLY_UPDATE_HEARTBEAT_URL=

# Map materialized-view refresh dead-man's switch; pinged only after success.
MAP_REFRESH_HEARTBEAT_URL=

# EDDN ingest freshness dead-man's switch: the external service alerts when
# the ping does not arrive. Leave the URL blank to disable the watchdog.
EDDN_WATCHDOG_HEARTBEAT_URL=
EDDN_WATCHDOG_MAX_AGE_MINUTES=30

# Repository/local inverted dead-man's switch: the disk watchdog uses these
# helper defaults to report a threshold breach as failure. They are retained
# for compatibility and are not V3 production capacity thresholds.
DISK_WATCHDOG_HEARTBEAT_URL=
DISK_WATCHDOG_MIN_FREE_GB=40
DISK_WATCHDOG_MAX_PERCENT_USED=80
DISK_WATCHDOG_PATH=/data

# Admin token used by application/admin flows that intentionally configure it.
# This example does not authorize any production host automation.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Frontier OAuth account sign-in. Keep the shared key server-side and out of
# Git/browser code. The redirect URI must exactly match the Frontier client.
FRONTIER_CLIENT_ID=
FRONTIER_CLIENT_SECRET=
FRONTIER_REDIRECT_URI=https://ed-finder.app/api/auth/frontier/callback
# Optional recovery allowlist of stable Frontier customer IDs. The normal
# first-time setup links the signed-in account using ADMIN_TOKEN once.
FRONTIER_OWNER_CUSTOMER_IDS=
# Production must remain true. Set false only for local plain-HTTP testing.
AUTH_COOKIE_SECURE=true

# Optional read-only station enrichment status artifact for the Admin tab.
# Generate it from an explicitly appropriate repository/operator context with:
#   python3 scripts/station_enrichment_status.py --json > /data/logs/station-enrichment-status.json
# Leave blank to show enrichment status as unavailable.
ENRICHMENT_STATUS_JSON_PATH=

# Optional read-only warehouse reconciliation/status artifact for the Admin tab.
# Publish only a sanitized/reviewed warehouse reconciliation JSON report to a
# path made available to the API. Leave blank to show status as unavailable.
ENRICHMENT_WAREHOUSE_STATUS_JSON_PATH=

# Comma-separated list of allowed CORS origins.
# Change this for staging/dev deployments.
CORS_ORIGINS=https://ed-finder.app,https://www.ed-finder.app

# Set to "true" only when debugging locally. Leaks asyncpg error text
# (SQL, table/column names) in HTTP responses when true.
EXPOSE_ERROR_DETAIL=false

# Logging level for all Python services.
LOG_LEVEL=INFO

# Maintenance retention posture for repository/local helper paths.
# Superseded/expired evidence rows keep the latest historical row per subject and
# prune older history after this many days during maintenance.
EVIDENCE_RECORD_RETENTION_DAYS=90
# These are repository defaults, not V3 production backup/PITR policy. V3
# retention and offsite storage must come from a current reviewed V3 runbook.
BACKUP_RETENTION_DAYS=14
BACKUP_RETENTION_MIN_ARCHIVES=3
BACKUP_OFFSITE_RETENTION_DAYS=30
BACKUP_OFFSITE_RETENTION_MIN_ARCHIVES=3
# Completed/failed admin job rows older than this are pruned during maintenance
# where that maintenance path is intentionally enabled.
ADMIN_JOB_RUN_RETENTION_DAYS=60

# Targeted EDSM enrichment pacing. Keep these conservative for bulk station/body
# backfills; Retry-After from EDSM is honored before these 429 defaults.
EDSM_HTTP_REQUEST_DELAY_SECONDS=0.5
EDSM_HTTP_429_BACKOFF_SECONDS=60
EDSM_HTTP_429_BACKOFF_MULTIPLIER=2

# Monitoring is opt-in. Put the Grafana password in a local file; Grafana's
# guarded entrypoint refuses empty, default, or placeholder credentials.
GRAFANA_USER=admin
GRAFANA_PASSWORD_FILE=./config/grafana_admin_password.local

# Optional native Healthchecks.io Prometheus integration. The targets file is
# a copy of config/healthchecks_targets.example.yml with the project UUID set;
# the token file contains only a read-only Healthchecks API key. Leave both
# blank to use the committed disabled/empty defaults and make no external call.
HEALTHCHECKS_PROMETHEUS_TARGETS_FILE=
HEALTHCHECKS_PROMETHEUS_TOKEN_FILE=

# Error tracking (GlitchTip, self-hosted Sentry-API-compatible) — fully
# opt-in end to end. See docs/operations/glitchtip-error-tracking.md.
#
# Enable the local/legacy Compose profile only in an environment where that
# stack is intentionally in use; this line is not a production instruction.
GLITCHTIP_POSTGRES_PASSWORD=
GLITCHTIP_SECRET_KEY=
GLITCHTIP_DOMAIN=http://localhost:8080
GLITCHTIP_DEFAULT_FROM_EMAIL=glitchtip@ed-finder.app

# After creating an org + project in the GlitchTip UI (see the runbook), set
# the DSNs it gives you here. Leave blank to disable API/frontend error
# capture entirely even if the glitchtip_* containers are running.
SENTRY_DSN=
VITE_SENTRY_DSN=

# Background task (apps/api/src/ingest/eddn_client.py): feeds
# journal_events/body_scan_facts from the live EDDN relay for the
# simulation/buildability engine. Independent of, not a replacement for,
# the client-side journal-import lane. Defaults on; set to false to
# disable without a redeploy.
EDDN_SIMULATION_INGEST_ENABLED=true

# Grafana's Sentry-compatible datasource, so error-rate trends sit next to
# the infra metrics dashboard. Requires a GlitchTip internal integration
# auth token (Read access to Project/Issue&Event/Organization) written to
# GLITCHTIP_GRAFANA_AUTH_TOKEN_FILE. Leave both blank/default to leave the
# datasource provisioned but unauthenticated.
GLITCHTIP_GRAFANA_ORG_SLUG=not-configured
GLITCHTIP_GRAFANA_AUTH_TOKEN_FILE=./config/glitchtip_grafana_auth_token.disabled

# Undocumented-env-var sweep (Emergent recurrence report A5, 2026-08-08).
# All nine have working code-level defaults already — none of these are
# required for a normal run — but none were discoverable from this file
# before now.
#
# apps/api/src/local_search.py's local-search radius tuning.
MAX_SEARCH_RADIUS_LY=10000
CLUSTER_RADIUS_LY=500
#
# apps/importer/src/build_grid.py's macro-grid cell size (light years).
CELL_SIZE=500
#
# apps/importer/src/inara_api.py: Inara API credentials for the (currently
# unused-by-default) Inara enrichment path. Leave the key as the placeholder
# to leave that path effectively disabled.
INARA_API_KEY=PLACEHOLDER_SET_INARA_API_KEY_IN_ENV
INARA_APP_NAME=ED-Finder
INARA_APP_VERSION=3.0
#
# apps/importer/src/region_map.py: override the bundled region_map.json
# path. Leave unset to use the committed file at
# apps/importer/src/data/region_map.json.
REGION_MAP_JSON=
#
# import_spansh.py / build_topology.py / build_ratings.py / build_grid.py:
# bypass pgbouncer and :5433 rewriting for a direct Postgres DSN. Leave
# unset to use each script's own derived-from-DATABASE_URL default.
DB_DSN_DIRECT=
#
# apps/importer/src/build_ratings.py: batch size for the dirty-ratings
# cleanup loop. RATING_DIRTY_CLEANUP_CHUNK takes precedence if both are set.
DIRTY_CLEANUP_CHUNK_SIZE=1000

{
  "name": "ed-finder",
  "private": true,
  "version": "0.1.2",
  "packageManager": "yarn@1.22.22",
  "type": "module",
  "description": "ED Finder frontend — Vite + React + TypeScript, served at /.",
  "scripts": {
    "dev:doctor": "node scripts/dev-doctor.mjs",
    "dev:doctor:strict": "node scripts/dev-doctor.mjs --strict",
    "prestart": "npm run dev:doctor",
    "predev": "npm run dev:doctor",
    "start": "node scripts/start-or-reuse.mjs",
    "dev": "vite",
    "map-foundation:test": "node scripts/run-vitest.mjs run src/features/map-foundation",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && vite build --configLoader runner && node scripts/assert-production-map-build.mjs",
    "build:typecheck": "tsc --noEmit && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && vite build --configLoader runner && node scripts/assert-production-map-build.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:typecheck": "tsc --noEmit -p .storybook/tsconfig.json 2>/dev/null || true",
    "lint": "eslint src cypress cypress.config.cjs --max-warnings 10",
    "test": "node scripts/run-vitest.mjs run",
    "test:operator": "node scripts/run-vitest.mjs run OperatorCockpitTab api.operator useHashRoute",
    "test:planner": "node scripts/run-vitest.mjs run src/features/colony-planner src/features/system-detail/simulation-preview",
    "test:map": "node scripts/run-vitest.mjs run src/features/map src/lib/api.map.test.ts",
    "test:stores": "node scripts/run-vitest.mjs run src/store src/hooks",
    "test:ci": "yarn test:operator && yarn test:planner && yarn test:map && yarn test:stores && node scripts/run-vitest.mjs run src/features/admin src/features/cluster-search src/features/expansion-plans src/features/fc-planner src/features/search-tuning src/features/system-detail/SystemDetailModal.test.tsx src/lib",
    "test:watch": "node scripts/run-vitest.mjs watch",
    "e2e": "cypress run --browser chrome --spec cypress/e2e/auth-owner-access.cy.js,cypress/e2e/release-gate.cy.js",
    "e2e:firefox": "cypress run --browser firefox --spec cypress/e2e/auth-owner-access.cy.js,cypress/e2e/release-gate.cy.js",
    "e2e:open": "cypress open",
    "types:gen": "node scripts/types-gen.mjs"
  },
  "dependencies": {
    "@deck.gl/core": "9.3.11",
    "@deck.gl/layers": "9.3.11",
    "@deck.gl/react": "9.3.11",
    "@deck.gl/widgets": "9.3.11",
    "@ed-finder/api-client": "file:../packages/api-client",
    "@ed-finder/planner-core": "file:../packages/planner-core",
    "@loaders.gl/core": "4.4.5",
    "@luma.gl/core": "9.3.6",
    "@luma.gl/engine": "9.3.6",
    "@luma.gl/shadertools": "9.3.6",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.7",
    "@react-three/fiber": "9.7.0",
    "@sentry/react": "^10.73.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "clsx": "^2.1.1",
    "json-with-bigint": "^3.5.10",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "three": "0.185.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-links": "10.6.0",
    "@storybook/addon-onboarding": "^10.6.0",
    "@storybook/react": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^5.0.0",
    "axe-core": "4.13.0",
    "canvas": "^3.2.3",
    "chromatic": "^18.7.2",
    "cypress": "16.0.0",
    "cypress-axe": "1.7.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jest-canvas-mock": "^2.5.8",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "openapi-typescript": "^7.4.4",
    "postcss": "^8.5.28",
    "storybook": "10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "workbox-build": "^7.3.0",
    "workbox-window": "^7.3.0"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ED-Finder asset provenance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "audit_date",
    "policy",
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./PROVENANCE.schema.json"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "audit_date": {
      "type": "string",
      "format": "date"
    },
    "policy": {
      "type": "string",
      "const": "assets/README.md"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "asset_type",
        "distribution",
        "source_kind",
        "source_url",
        "license",
        "creator",
        "frontier_derived",
        "attribution_text",
        "approval_date",
        "verification_method",
        "sha256",
        "rights_status",
        "commercial_use_approved",
        "notice_reference"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\\\]+$"
        },
        "asset_type": {
          "type": "string",
          "enum": [
            "data",
            "font",
            "image",
            "license_text",
            "script",
            "shader_source",
            "third_party_code_adaptation"
          ]
        },
        "distribution": {
          "type": "string",
          "enum": [
            "bundled_public",
            "bundled_source",
            "runtime_external"
          ]
        },
        "source_kind": {
          "type": "string",
          "enum": [
            "original",
            "open_source",
            "open_licensed_media",
            "frontier_game",
            "community_creator",
            "unknown"
          ]
        },
        "source_url": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            {
              "type": "null"
            }
          ]
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "creator": {
          "type": "string",
          "minLength": 1
        },
        "frontier_derived": {
          "type": "boolean"
        },
        "attribution_text": {
          "type": "string",
          "minLength": 1
        },
        "approval_date": {
          "type": "string",
          "format": "date"
        },
        "verification_method": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "rights_status": {
          "type": "string",
          "enum": [
            "approved",
            "noncommercial_only",
            "unresolved"
          ]
        },
        "commercial_use_approved": {
          "type": "boolean"
        },
        "notice_reference": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
